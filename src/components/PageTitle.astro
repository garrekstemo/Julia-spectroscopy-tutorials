<style>
  .page-title {
    font-family: "Libre Baskerville", Georgia, "Times New Roman", serif;
    font-size: 2em;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.5em 0;
    color: var(--sl-color-white);
  }
</style>
